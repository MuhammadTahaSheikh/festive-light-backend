# ─────────────────────────────────────────────────────────────
# Festive Lighting Pros — environment configuration
# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real .env file (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Port the server listens on
PORT=3000

# ── Google Cloud ────────────────────────────────────────────
# One Google Cloud project can power all three of these.
# Enable in the Google Cloud console:
#   1. "Places API (New)"        -> address autocomplete + details
#   2. "Street View Static API"  -> fetches the photo of the house
#   3. "Geocoding API"           -> address -> lat/lng fallback
#   4. "Solar API" (optional)    -> building footprint sqft on address preview
#
# Create an API key under APIs & Services > Credentials.
# This key is used SERVER-SIDE only, so restrict it by API (not by
# HTTP referrer). Billing must be enabled on the project.
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ── Gemini (Nano Banana image editing) ──────────────────────
# Get a key from https://aistudio.google.com/apikey
# This edits the Street View photo to add permanent lighting.
GEMINI_API_KEY=your_gemini_key_here

# Image model used to repaint the house. Options (best -> cheapest):
#   gemini-3.1-flash-image   (Nano Banana 2, recommended)
#   gemini-2.5-flash-image   (legacy Nano Banana)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Render provider ─────────────────────────────────────────
# Choose which service repaints the house:
#   cloudflare = Cloudflare Workers AI img2img (FREE tier, no credit card)
#   gemini     = Google Gemini image (paid, best quality)
# Leave blank to auto-pick (cloudflare if its keys are set, else gemini).
RENDER_PROVIDER=cloudflare

# Cloudflare Workers AI — sign up free at https://dash.cloudflare.com
#   CLOUDFLARE_ACCOUNT_ID: dashboard -> right sidebar / URL after /accounts/...
#   CLOUDFLARE_API_TOKEN:  My Profile -> API Tokens -> Create Token
#                          -> use the "Workers AI" template (read is enough)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_IMAGE_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img

# ── Supabase (database) ─────────────────────────────────────
# Create a project at https://supabase.com, then:
#   Project Settings > Data API  -> copy the Project URL
#   Project Settings > API Keys  -> copy the "service_role" secret key
# The service_role key is SERVER-SIDE ONLY. Never expose it in the browser.
# Run supabase/schema.sql in the SQL Editor to create the tables.
# If these are left blank, the app falls back to storing data in data/*.json.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here
# Optional — for npm run setup:credits (auto-create credit tables):
# SUPABASE_DB_PASSWORD=   # Project Settings → Database → database password
# Or: SUPABASE_ACCESS_TOKEN=sbp_...  # Account → Access Tokens

# ── Demo widget limits ──────────────────────────────────────
# How many free renders per visitor before we ask them to book a call.
MAX_FREE_RENDERS=3

# ── Credits (Outreach / batch renders) ───────────────────
# 1 credit ≈ 1 AI render quote in campaigns. Widget renders stay free (client-side limit).
STARTING_CREDITS=5
CREDITS_PER_RENDER=1
# Default $/ft for campaign batch renders when not set in UI (e.g. 40 = $4,000 for ~100 ft).
DEFAULT_PRICE_PER_FOOT=40
BILLING_MODE=demo
# For Stripe test mode: set BILLING_MODE=stripe and paste keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from: stripe listen --forward-to localhost:3100/api/credits/stripe-webhook
# PUBLIC_BASE_URL=http://localhost:5173   # dev dashboard URL for Stripe redirect back after checkout

# ── Lob direct mail (physical postcards) ───────────────────
# 1. Sign up at https://dashboard.lob.com
# 2. Add a verified return address in Lob dashboard
# 3. Use LIVE key (test_ keys do NOT print/mail — API test only)
# LOB_API_KEY=live_xxxxxxxx
# LOB_MAIL_MODE=live
# PUBLIC_BASE_URL=https://your-ngrok-or-domain.com   # must be HTTPS, not localhost
# MAIL_FROM_NAME=Festive Lighting Pros
# MAIL_FROM_LINE1=123 Main Street
# MAIL_FROM_CITY=Sarasota
# MAIL_FROM_STATE=FL
# MAIL_FROM_ZIP=34236

# ── Owner lookup (campaign → Find owner names for postcards) ──
# Default: ATTOM Data API — 30-day free trial at https://api.developer.attomdata.com
# OWNER_LOOKUP_PROVIDER=attom
# ATTOM_API_KEY=your_attom_api_key

# Optional: AssessorSearch — https://assessorsearch.com/pricing
# OWNER_LOOKUP_PROVIDER=assessorsearch
# ASSESSORSEARCH_API_KEY=

# Optional: BatchData — https://batchdata.com
# OWNER_LOOKUP_PROVIDER=batchdata
# BATCHDATA_API_KEY=
# BATCHDATA_SKIP_TRACE=false
