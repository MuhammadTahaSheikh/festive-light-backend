{
  "name": "festive-light-launch",
  "version": "1.0.0",
  "description": "Festive Lighting Pros — React dashboard + Node API with an AI 'see your home lit up' render widget.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "client:install": "npm install --prefix client",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "build": "npm run client:build",
    "postinstall": "npm install --prefix client",
    "test": "node --test --import ./server/tests/setup.js server/tests/creditPackages.test.js server/tests/credits.test.js server/tests/creditsRoutes.test.js server/tests/postcardMerge.test.js server/tests/addressVerify.test.js server/tests/blockWave.test.js server/tests/pricing.test.js",
    "setup:credits": "node scripts/setup-credits.js",
    "setup:outreach": "node scripts/setup-outreach-columns.js",
    "setup:created-by": "node scripts/setup-created-by.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "push:split": "node scripts/sync-push-github.js"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "@supabase/supabase-js": "^2.110.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "stripe": "^22.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
